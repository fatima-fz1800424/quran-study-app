# Build context is `backend/`, so these paths are relative to it.
#
# Two jobs here. The obvious one is keeping the image small. The one that
# actually matters is keeping secrets and 550MB of local cache out of the build
# context entirely - anything sent to the daemon can end up in a layer, and
# `docker history` on a published image is readable by anyone who pulls it.

# Version control. Sending .git would ship every past revision of every file
# inside the build context, which is both large and a disclosure risk.
.git
.gitignore
.gitattributes

# Python bytecode and tooling caches.
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtualenvs. These hold platform-specific binaries built for Windows here,
# which are useless in a Linux image and would shadow the site-packages that
# pip installs inside it.
.venv/
venv/
env/
ENV/
*.egg-info/

# Secrets. Nothing in this project commits a key, and nothing should bake one
# into a layer either - GEMINI_API_KEY is passed at run time. Listed
# defensively so that a future local .env cannot be picked up silently.
.env
.env.*
*.pem
*.key
secrets.json

# The local retrieval cache: ~552MB of model weights and embeddings. The image
# builds its own copy in a dedicated layer, so shipping this one would double
# the weights and risk baking in embeddings from a stale corpus.
.retrieval_cache/

# Evaluation and research artefacts. Useful in the repo, dead weight at
# runtime - the served endpoints never read them.
run_eval.py
run_eval_weighted_context.py
run_retrieval_queries.py
run_variant_sweep.py
variant_sweep_results.json
eval_queries.json
build_corpus.py
test_ask_guardrails.py

# Operational tooling. Runs on a laptop against the API, never inside the
# served image.
tools/

# Docs and container files. The Dockerfile does not need to be inside its own
# image.
Dockerfile
.dockerignore
README.md
